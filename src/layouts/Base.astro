---
import '../styles/global.css';
import { defaultLevel, levelIds, levels } from '../data/levels';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  current?: 'start' | 'reise' | 'themen';
}

const {
  title,
  description = 'Eine kompakte, interaktive Lernreise durch die Welt der Künstlichen Intelligenz – angepasst an deinen Wissensstand.',
  current,
} = Astro.props;
const fullTitle = title ? `${title} · KI verstehen` : 'KI verstehen – deine Lernreise';

// CSS, das Inhalte nur für die aktive Stufe anzeigt. Wird aus levels.ts erzeugt,
// damit neue Stufen automatisch funktionieren.
const levelCss = levelIds
  .map((id) => `html[data-level="${id}"] [data-lvl]:not([data-lvl~="${id}"]){display:none!important}`)
  .join('\n');

const nav = [
  { id: 'start', label: 'Quiz', href: url() },
  { id: 'reise', label: 'Lernreise', href: url('reise/') },
  { id: 'themen', label: 'Themen', href: url('themen/') },
] as const;
---

<!doctype html>
<html lang="de" data-level={defaultLevel}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline define:vars={{ levelIds }}>
      // Läuft vor dem ersten Zeichnen: Stufe aus dem Speicher setzen, damit nichts flackert.
      document.documentElement.classList.add('js');
      try {
        const p = JSON.parse(localStorage.getItem('kiReise.profile') || 'null');
        if (p && levelIds.includes(p.level)) document.documentElement.dataset.level = p.level;
      } catch (e) {}
    </script>
    <style set:html={levelCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url()} aria-label="KI verstehen – Startseite">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
            <g stroke="var(--accent-ink)" stroke-width="1.6" fill="none"><path d="M9 10l7 6-7 6M16 16h7"></path></g>
            <g fill="var(--accent-ink)"><circle cx="9" cy="10" r="2.4"></circle><circle cx="9" cy="22" r="2.4"></circle><circle cx="16" cy="16" r="2.4"></circle><circle cx="23" cy="16" r="2.4"></circle></g>
          </svg>
          <span>KI verstehen</span>
        </a>
        <nav aria-label="Hauptnavigation">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="level-pill" href={url('#quiz')} title="Deine Stufe – Quiz wiederholen">
          {
            levels.map((l) => (
              <span data-lvl={l.id}>
                <span aria-hidden="true">{l.emoji}</span> <span class="level-pill-name">{l.name}</span>
              </span>
            ))
          }
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          KI verstehen – eine offene Lernreise. Stand der Inhalte: Herbst 2026. Die KI-Welt bewegt sich schnell – Angaben
          ohne Gewähr.
        </p>
        <p class="muted">Dein Quiz-Ergebnis wird nur in deinem Browser gespeichert.</p>
      </div>
    </footer>

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -100px;
    z-index: 100;
    background: var(--accent);
    color: var(--accent-ink);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--radius-sm);
  }
  .skip:focus {
    top: var(--s-2);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: 60px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo span {
    display: none;
  }
  @media (min-width: 640px) {
    .logo span {
      display: inline;
    }
  }
  nav ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-3);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    transition: color var(--motion-150) var(--ease-out);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    background: var(--surface-2);
  }
  .level-pill {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--s-3);
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .level-pill-name {
    display: none;
  }
  @media (min-width: 480px) {
    .level-pill-name {
      display: inline;
    }
  }
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--s-9);
    padding: var(--s-6) 0;
    font-size: var(--text-sm);
  }
  .footer-inner p {
    margin: 0 0 var(--s-2);
  }
</style>
