---
import { getCollection } from 'astro:content';
import raw from '../data/zukunft.json';

// Reihenfolge wie in der JSON-Datei
const order = raw.map((r) => r.id);
const all = (await getCollection('zukunft')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const columns = [
  { id: 'bald', title: 'Bald', sub: 'in 1–3 Jahren' },
  { id: 'mittel', title: 'Mittelfristig', sub: 'in 3–10 Jahren' },
  { id: 'offen', title: 'Offen', sub: 'langfristig & umstritten' },
] as const;
const confidence = {
  hoch: { label: 'Sehr wahrscheinlich', dots: 3 },
  mittel: { label: 'Gut möglich', dots: 2 },
  spekulativ: { label: 'Spekulativ', dots: 1 },
} as const;
---

<div class="future">
  {
    columns.map((col, ci) => (
      <section class="col" aria-labelledby={`fut-${col.id}`}>
        <header class="col-head reveal" style={`--i:${ci}`}>
          <h3 id={`fut-${col.id}`}>{col.title}</h3>
          <span class="muted">{col.sub}</span>
        </header>
        <ul>
          {all
            .filter((f) => f.data.horizon === col.id)
            .map((f, i) => (
              <li class="card item reveal" style={`--i:${ci + i}`}>
                <h4>{f.data.title}</h4>
                <p>{f.data.text}</p>
                <span class={`conf conf-${f.data.confidence}`}>
                  <span class="dots" aria-hidden="true">
                    {[1, 2, 3].map((d) => (
                      <span class:list={['d', { on: d <= confidence[f.data.confidence].dots }]} />
                    ))}
                  </span>
                  {confidence[f.data.confidence].label}
                </span>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .future {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }
  @media (min-width: 900px) {
    .future {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .col-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: 2px solid var(--accent);
  }
  .col-head h3 {
    margin: 0;
  }
  .col-head span {
    font-size: var(--text-sm);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .item {
    padding: var(--s-4);
  }
  h4 {
    margin: 0 0 var(--s-1);
    font-size: var(--text-base);
  }
  .item p {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--s-3);
  }
  .conf {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .dots {
    display: inline-flex;
    gap: 3px;
  }
  .d {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .conf-hoch .d.on {
    background: var(--good);
  }
  .conf-mittel .d.on {
    background: var(--warn);
  }
  .conf-spekulativ .d.on {
    background: var(--accent);
  }
</style>
